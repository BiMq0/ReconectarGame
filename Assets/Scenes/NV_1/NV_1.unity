  m_GameObject: {fileID: 562143396}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 146fea4dedaff4242b4bb6ca0cde60fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  eventID: JUGO_EVENT
  specialCode: chicha
  interactionIndicator: {fileID: 1812578303}
  panelJugo: {fileID: 2132878016}
  dialogueManager: {fileID: 95859954}
  crowdAnimator: {fileID: 212898865}
  nayeliAnimator: {fileID: 1527821167}
  introductionDialogue:
  - speaker: 1
    text: ...
    expressionIndex: 1
  - speaker: 1
    text: "C\xF3mo rayos pasar\xE9 entre toda esta gente??"
    expressionIndex: 1
  - speaker: 1
    text: La chica dijo algo sobre empujar...
    expressionIndex: 1
  - speaker: 1
    text: Intentemos eso. (usa click izquierdo para forcejear)
    expressionIndex: 1
  - speaker: 1
    text: Recuerda Raymi, lo que quieres es un jugo sabor CHICHA.
    expressionIndex: 1
  - speaker: 2
    text: "EH EH EH, qu\xE9 le pas\xE1??"
    expressionIndex: 2
  approachDialogue:
  - speaker: 1
    text: "B-bueno d\xEDas!"
    expressionIndex: 1
  - speaker: 0
    text: "Buen d\xEDa, d\xEDgame qu\xE9 jugo le sirvo"
    expressionIndex: 0
  - speaker: 0
    text: Apurese que no tengo mucho tiempo
    expressionIndex: 0
  - speaker: 1
    text: "De acuerdo! Necesito un jugo deee:\t "
    expressionIndex: 1
  successDialogue:
  - speaker: 0
    text: "Bien, ac\xE1 est\xE1 su jugo de chicha"
    expressionIndex: 0
  - speaker: 1
    text: Perfecto, muchas gracias
    expressionIndex: 1
  - speaker: 0
    text: Regrese pronto y eso,
    expressionIndex: 0
  - speaker: 1
    text: "Ahora necesito una \xFAltima cosa.."
    expressionIndex: 1
  failureDialogue:
  - speaker: 0
    text: ...
    expressionIndex: 0
  - speaker: 0
    text: "Lo siento, hace retrasar a los dem\xE1s"
    expressionIndex: 0
  - speaker: 1
    text: PERO
    expressionIndex: 1
  - speaker: 1
    text: "Cielos... Aqu\xED vamos otra vez (recuerda que necesitamos un jugo de
      CHICHA)"
    expressionIndex: 1
  clicksPerPhase: 5
  decayTimerDuration: 2
  inputTimeLimit: 15
