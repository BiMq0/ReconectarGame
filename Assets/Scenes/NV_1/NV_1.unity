MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 190252335}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1915836ffeb9d2d4ebccda4067fb9f47, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  eventID: "NI\xD1O_EVENT"
  interactionIndicator: {fileID: 431184659}
  dialoguePanel: {fileID: 149382310}
  dialogueText: {fileID: 2067008457}
  kidExpressionImage: {fileID: 203677925}
  "carasNi\xF1o":
  - {fileID: 21300000, guid: 9f87f2aecd81e6145a00623ef2e6c984, type: 3}
  - {fileID: 21300000, guid: 4306bd2241321bd44903951a9f7e1541, type: 3}
  - {fileID: 21300000, guid: a26116459cb4a7c42ba2a7c518140b04, type: 3}
  introductionDialogue:
  - speaker: 1
    text: HOLAA, disculpa amigo no tuviera un poco de pan?
    expressionIndex: 0
  - speaker: 0
    text: "Eh sisis hay pancito. Qu\xE9 tipo le doy??"
    expressionIndex: 1
  - speaker: 1
    text: Deme 3 sarnas y 2 marraquetas porfa
    expressionIndex: 1
  - speaker: 0
    text: "Ac\xE1 tiene. Ser\xEDan... ehhh 1, 2, 3.... "
    expressionIndex: 0
  - speaker: 0
    text: "No recuerdo bien el precio, podr\xEDas ayudarme? seguramente t\xFA le
      sabes."
    expressionIndex: 1
  - speaker: -1
    text: "\"Parece que tiene problemas con el conteo, qu\xE9 deber\xEDa hacer??
      obviamente s\xE9 que el pan est\xE1 a 50 ctvs\""
    expressionIndex: 1
  decisionOptions:
  - Decir la Verdad (Precio real)
  - "Mentir y decir un precio m\xE1s bajo"
  - Decir que no sabes el precio
  route1Dialogue:
  - speaker: 0
    text: AAAH VERDAD, muchas gracias
    expressionIndex: 0
  - speaker: 1
    text: No es nada, gracias a vos. Nos vemos chaooo
    expressionIndex: 0
  route2Dialogue:
  - speaker: 0
    text: "Ehh est\xE1s seguro? "
    expressionIndex: 2
  - speaker: 1
    text: "Sisi, as\xED est\xE1 en el mercado"
    expressionIndex: 2
  - speaker: 0
    text: De acuerdo, muchas gracias
    expressionIndex: 2
  route3Dialogue:
  - speaker: 0
    text: Uhm uhm
    expressionIndex: 2
  - speaker: 1
    text: ...
    expressionIndex: 2
  - speaker: 0
    text: "VERDA ya me acord\xE9, son 50 ctvs"
    expressionIndex: 0
  - speaker: 1
    text: "Perfecto ah\xED est\xE1n- Muchas graciaas"
    expressionIndex: 0
  typeSpeed: 50
