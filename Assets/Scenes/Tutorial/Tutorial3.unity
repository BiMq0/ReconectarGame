--- !u!114 &1969044131
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1969044127}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6c71b332a2a2ca94db64538e5b8e41b7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  eventID: YATIRI_EVENT
  interactionIndicator: {fileID: 1811699705}
  panelYatiri: {fileID: 900737103}
  dialogueManager: {fileID: 442068466}
  introductionDialogue:
  - speaker: 0
    text: ... Si... Malas vibras...
    expressionIndex: 0
  - speaker: 1
    text: Eh? Me habla a mi?
    expressionIndex: 1
  - speaker: 0
    text: 'SI. TIENES MALAS VIBRAS W. ENTRA ENTRA '
    expressionIndex: 0
  - speaker: 1
    text: De acuerdo, de acuerdo!
    expressionIndex: 1
  - speaker: 1
    text: Debo acercarme y presionar "E" para entrar..
    expressionIndex: 1
  interactionDialogue:
  - speaker: 0
    text: "EST\xC1S MALDITOO!"
    expressionIndex: 0
  - speaker: 1
    text: QUIEN YO?
    expressionIndex: 1
  - speaker: 0
    text: "Asi es. Algo viene sigui\xE9ndote desde hace un tiempo"
    expressionIndex: 0
  - speaker: 0
    text: "Un alma en pena est\xE1 llam\xE1ndote!"
    expressionIndex: 0
  - speaker: 1
    text: "(Qu\xE9? No mas amarres por favor... A menos que...)"
    expressionIndex: 1
  - speaker: 1
    text: "Y c\xF3mo resuelvo esto? C\xF3mo hago para que el alma descanse??"
    expressionIndex: 1
  - speaker: 0
    text: Para tu suerte no se debe hacer mucho
    expressionIndex: 0
  - speaker: 0
    text: "Debes reunir ciertas cosas y llev\xE1rlas a su tumba"
    expressionIndex: 0
  - speaker: 0
    text: "S\xF3lo as\xED el alma podr\xE1 dejar este mundo terrenal y adentrarse
      en su camino para ascender"
    expressionIndex: 0
  - speaker: 1
    text: "Qu\xE9 clase de objetos debo recolectar??"
    expressionIndex: 1
  - speaker: 0
    text: Ten esta lista, ve al mercado y reune las cosas
    expressionIndex: 0
  - speaker: 1
    text: 'De acuerdo, muchas gracias!! '
    expressionIndex: 1
  - speaker: 1
    text: 'Tal vez... '
    expressionIndex: 1
  - speaker: 1
    text: "Chiru... De verdad sigues aqu\xED?"
    expressionIndex: 1
