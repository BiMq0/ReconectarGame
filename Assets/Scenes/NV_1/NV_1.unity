  animator: {fileID: 1240340140}
  dialogue:
  - text: Ahora necesito un jugo de chicha
    expressionIndex: 1
  - text: ??
    expressionIndex: 1
  - text: "Quee, de d\xF3nde sali\xF3 tanta gente??"
    expressionIndex: 1
  - text: Eh, no lo sabes??
    expressionIndex: 0
  - text: "La hija de Do\xF1a Remedios, Nayeli, volvi\xF3 "
    expressionIndex: 0
  - text: los jugos que prepara son demasiado ricos
    expressionIndex: 0
  - text: "(qu\xE9 ptada)"
    expressionIndex: 1
  - text: Eso tiene sentido, muchas gracias
    expressionIndex: 1
  - text: "Deber\xEDas intentarlo, quiz\xE1 empujar a toda esa gente te abra el camino"
    expressionIndex: 0
  - text: "*gui\xF1o*"
    expressionIndex: 0
  typeSpeed: 50
  autoPauseDuration: 1.5
